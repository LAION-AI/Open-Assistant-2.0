# Open Assistant frontend (Bun) — public edge behind Caddy; owns user.db
# (accounts, passkeys, api keys, credits). Mirrors the `frontend` service in
# docker-compose.yml.
[Unit]
Description=Open Assistant frontend
Wants=oa-frontend-build.service oa-backend.service
After=oa-frontend-build.service oa-backend.service

[Container]
Image=localhost/open-assistant-frontend:latest
ContainerName=frontend
Network=open-assistant.network
# .env must define ALLOWED_HOSTS=<your domain> (quadlet can't remap
# ${DOMAIN} the way compose does) plus the optional EMAIL* SMTP settings;
# frontend.env holds JWT_SECRET and FEEDBACK_TOKEN.
EnvironmentFile=/mnt/storage/open-assistant/.env
EnvironmentFile=/mnt/storage/open-assistant/frontend.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=BACKEND_URL=http://backend:8080
Environment=USER_DB=/data/user.db
Volume=/mnt/storage/open-assistant/data/frontend:/data:z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
